{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rabbittodo",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rabbittodo",
      "database_id": "dffd7c10-ea1d-4aa0-b4f1-15b74936cfd8",
      "migrations_dir": "migrations"
    }
  ]
}

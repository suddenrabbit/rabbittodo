{
  "name": "rabbittodo-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create rabbittodo",
    "db:backup:remote": "./scripts/backup-remote-d1.sh",
    "db:migrate:local": "wrangler d1 migrations apply rabbittodo --local",
    "db:migrate:remote": "wrangler d1 migrations apply rabbittodo --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
